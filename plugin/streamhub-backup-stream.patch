+    def _substitute_ads(self, playlist: TwitchM3U8) -> bool:
+        """StreamHub: replace ad segments in-place with matching segments of the backup stream"""
+        backup_segments = self.stream.backup.segments()
+        if not backup_segments:
+            return False
+
+        available = [segment for segment in backup_segments if segment.uri not in self.backup_written]
+        replaced = 0
+        for idx, segment in enumerate(playlist.segments):
+            if not segment.ad:
+                continue
+            match = self._match_backup_segment(segment, available)
+            if match is None:
+                continue
+            available.remove(match)
+            self.backup_written.append(match.uri)
+            playlist.segments[idx] = dataclass_replace(
+                segment,
+                uri=match.uri,
+                duration=match.duration,
+                title=None,
+                key=match.key,
+                map=match.map,
+                byterange=match.byterange,
+                # the backup stream has a different resolution: let the player know
+                discontinuity=True,
+                ad=False,
+                prefetch=False,
+            )
+            replaced += 1
+
+        if replaced:
+            log.debug(f"Replaced {replaced} ad segment(s) with backup stream segments")
+
+        return not any(segment.ad for segment in playlist.segments)
+
+    @staticmethod
+    def _match_backup_segment(segment: TwitchHLSSegment, backup_segments: list[TwitchHLSSegment]):
+        if not backup_segments:
+            return None
+        if segment.date is None:
+            # no timestamps: use backup segments in order
+            return backup_segments[0]
+        dated = [backup for backup in backup_segments if backup.date is not None]
+        if not dated:
+            return backup_segments[0]
+        best = min(dated, key=lambda backup: abs((backup.date - segment.date).total_seconds()))
+        # don't play content from a very different point in time
+        if abs((best.date - segment.date).total_seconds()) > max(6.0, segment.duration * 3):
+            return None
+        return best
+
 
