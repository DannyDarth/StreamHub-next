+class TwitchBackupStream:
+    """
+    StreamHub: an ad-free, usually lower quality stream of the same channel, used during ad breaks.
+
+    Twitch serves streams for different player types. When the regular stream contains ads, the stream of another
+    player type often doesn't (in a lower resolution). The first player type whose playlist has no ad segments is used.
+    """
+
+    PLAYER_TYPES = ("autoplay", "picture-by-picture", "embed", "site", "popout")
+    PREFERRED_HEIGHTS = (360, 480, 160)
+    RETRY_DELAY = 10.0
+
+    def __init__(self, plugin: Twitch, channel: str, player_types: list[str] | None = None):
+        self.plugin = plugin
+        self.channel = channel
+        self.player_types = list(player_types or self.PLAYER_TYPES)
+        self.media_url: str | None = None
+        self.player_type: str | None = None
+        self._next_attempt = 0.0
+
+    def segments(self) -> list[TwitchHLSSegment] | None:
+        if self.media_url:
+            playlist = self._fetch_media(self.media_url)
+            if playlist is not None and playlist.segments and not any(segment.ad for segment in playlist.segments):
+                return playlist.segments
+            log.info(f"Backup stream ({self.player_type}) contains ads, looking for another one")
+            self.media_url = self.player_type = None
+
+        # don't query Twitch for every playlist reload if no backup stream is available
+        if time.monotonic() < self._next_attempt:
+            return None
+
+        for player_type in self.player_types:
+            try:
+                media_url = self._media_url(player_type)
+            except Exception as err:
+                log.debug(f"Backup stream ({player_type}) unavailable: {err}")
+                continue
+            if not media_url:
+                continue
+            playlist = self._fetch_media(media_url)
+            if playlist is None or not playlist.segments or any(segment.ad for segment in playlist.segments):
+                log.debug(f"Backup stream ({player_type}) contains ads")
+                continue
+            self.media_url, self.player_type = media_url, player_type
+            log.info(f"Using ad-free backup stream ({player_type}) during ad breaks")
+            return playlist.segments
+
+        log.info("No ad-free backup stream available")
+        self._next_attempt = time.monotonic() + self.RETRY_DELAY
+        return None
+
+    def _media_url(self, player_type: str) -> str | None:
+        api = self.plugin.api
+        params = api.access_token_params
+        api.access_token_params = {**params, "playerType": player_type}
+        try:
+            sig, token, _restricted = self.plugin._access_token(True, self.channel)
+        finally:
+            api.access_token_params = params
+
+        url = self.plugin.usher.channel(self.channel, sig=sig, token=token, fast_bread=True)
+        res = self.plugin.session.http.get(url, proxies={})
+        multivariant = parse_m3u8(res, url, parser=TwitchM3U8Parser)
+
+        # video variants only (audio_only has no resolution); works on Streamlink 8.3 (no HLSPlaylist.get_name())
+        candidates = [
+            playlist for playlist in multivariant.playlists
+            if not playlist.is_iframe and self._height(playlist)
+        ]
+        if not candidates:
+            return None
+        for height in self.PREFERRED_HEIGHTS:
+            for playlist in candidates:
+                if self._height(playlist) == height:
+                    return playlist.uri
+
+        return min(candidates, key=lambda playlist: playlist.stream_info.bandwidth).uri
+
+    @staticmethod
+    def _height(playlist) -> int | None:
+        resolution = getattr(playlist.stream_info, "resolution", None)
+        return resolution.height if resolution else None
+
+    def _fetch_media(self, url: str) -> TwitchM3U8 | None:
+        try:
+            res = self.plugin.session.http.get(url, proxies={})
+            return parse_m3u8(res, url, parser=TwitchM3U8Parser)
+        except Exception as err:
+            log.debug(f"Could not load backup stream playlist: {err}")
+            return None
 
 
