{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamHub",
  "version": "2.0.0-alpha.1",
  "identifier": "com.dannydarth.streamhub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StreamHub",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.twitch.tv https://id.twitch.tv; img-src 'self' data: https://static-cdn.jtvnw.net https://*.kick.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DannyDarth",
    "copyright": "Copyright (c) DannyDarth. MIT License.",
    "category": "Entertainment",
    "shortDescription": "Ad-free Twitch streams through Streamlink",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/streamlink-plugins/": "streamlink-plugins/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
